FROM agent_runtime

USER root

# The normal Runtime image stays production-small.  Only this opt-in worker
# receives Git and the locked test toolchain needed to create detached
# worktrees and run governed candidate checks.
RUN apt-get -o Acquire::Retries=5 -o Acquire::https::Timeout=60 update \
    && apt-get -o Acquire::Retries=5 -o Acquire::https::Timeout=60 \
        install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/* \
    && uv sync --frozen --group dev --no-install-project \
    && mkdir -p /evolution-sandbox \
    && chown 10001:10001 /evolution-sandbox

# The candidate checkout is scrubbed of evals/sealed and Git objects before any
# candidate code runs.  Production suite manifests and sources are copied to an
# immutable image path and executed by this trusted runner, never from the
# candidate worktree.  This is workspace separation, not a malicious-code
# process boundary; see README.md before treating results as promotion evidence.
COPY src/evolution/regression_runner.py /opt/ratsnest-evolution-evaluator/regression_runner.py
COPY src/evolution/generator_validation.py /opt/ratsnest-evolution-evaluator/generator_validation.py
COPY evals/sealed/regression/ /opt/ratsnest-evolution-evaluator/evals/sealed/regression/
RUN chmod -R a-w /opt/ratsnest-evolution-evaluator

USER 10001:10001

CMD ["python", "-m", "evolution.temporal.worker"]
