# Server-only Java control-plane address.
CONTROL_PLANE_URL=http://control-plane:8080

# Enable only when Next.js is reachable exclusively through an OIDC proxy that
# overwrites the access-token headers before forwarding the request.
WEB_TRUST_OIDC_PROXY_ACCESS_TOKEN=false

# Optional server-only local-development token. Do not use a shared production
# credential here; production requests must carry the user's OIDC access token.
CONTROL_PLANE_ACCESS_TOKEN=

# Disabled by default. Enables the paired-evaluation page and its allowlisted
# execution handoff through the existing Java control plane.
RATSNEST_EVAL_MODE_ENABLED=false

PORT=3000
