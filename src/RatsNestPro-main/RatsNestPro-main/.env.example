# RatsNestPro configuration — copy to `.env` and edit the paths.
#
# Real KiCad symbol/footprint libraries used to ground pin & pad geometry.
# Point these at the KiCad official libraries (or your own). Multiple paths
# may be separated by the OS path separator (';' on Windows, ':' elsewhere).
#
# New KiCad 10 symbol format uses <nick>.kicad_symdir/ directories; the legacy
# single-file <nick>.kicad_sym format is also supported.

KICAD_SYMBOL_DIR=C:\Users\ewneiiy\OneDrive - Ericsson\Desktop\kicad-symbols-master
KICAD_FOOTPRINT_DIR=C:\Users\ewneiiy\OneDrive - Ericsson\Desktop\kicad-footprints-master

# Optional: override the fab process capability table (min track/clearance/via
# etc.). Defaults to the bundled data/process_capability.json (JLCPCB standard).
# RATSNESTPRO_PROCESS_CAPABILITY=C:\path\to\my_fab_capability.json
